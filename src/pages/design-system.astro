---
// Page Design System (Astro) — référence vivante des composants.
// Un modèle de chaque bouton de la rampe. (Produit B legacy = gelé, indépendant.)
import Layout from '../layouts/Layout.astro'
import Add from '../assets/pictos/add.svg'
import Pulpe from '../assets/pictos/Vector.svg'
import orangerieUrl from '../assets/pictos/orangerie.svg?url'
import arrowUrl from '../assets/pictos/simple.svg?url'

const loremRegular =
  'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Espace de travail partagé géré par l’association Pulpe.'
const loremHighlight =
  'Un espace de travail partagé, géré par l’association Pulpe, au cœur de Malestroit.'
---

<Layout title="Design System — L'Orangerie">
  <section class="u-container u-section ds">
    <h1 class="ds__title">Design System</h1>

    <h2 class="ds__section-title">Boutons</h2>

    <div class="ds__group">
      <div class="ds__item">
        <a href="#" class="btn--primary">Bouton primary</a>
        <code>.btn--primary</code>
      </div>
      <div class="ds__item">
        <a href="#" class="btn--secondary">Bouton secondary</a>
        <code>.btn--secondary</code>
      </div>
      <div class="ds__item">
        <button type="button" class="btn--fab" aria-label="Ajouter">
          <Add class="btn--fab__icon" width={40} height={40} aria-hidden="true" />
        </button>
        <code>.btn--fab</code>
      </div>
      <div class="ds__item">
        <a href="#" class="btn--lien">Lien cliquable</a>
        <code>.btn--lien</code>
      </div>
      <div class="ds__item">
        <a href="#" class="btn--nav-primary">Nav primary</a>
        <code>.btn--nav-primary</code>
      </div>
      <div class="ds__item">
        <a href="#" class="btn--nav-secondary">Nav secondary</a>
        <code>.btn--nav-secondary</code>
      </div>
    </div>

    <h2 class="ds__section-title">Boutons d’index</h2>
    <p class="ds__note">
      Marqueur de la dot-nav (<code>nav/index_boutons</code>). Affichage statique de
      référence — la dot-nav vivante (rail sticky + scrollspy) viendra plus tard.
    </p>

    <h3 class="ds__subsection-title">Desktop</h3>
    <div class="ds__group ds__group--index">
      <div class="ds__item">
        <span class="index-nav__item index-nav__item--start">
          <span class="index-nav__dot" aria-hidden="true"></span>
          <span class="index-nav__label">Notre fonctionnement</span>
        </span>
        <code>--start</code>
      </div>
      <div class="ds__item">
        <span class="index-nav__item index-nav__item--bellow">
          <span class="index-nav__dot" aria-hidden="true"></span>
          <span class="index-nav__label">Notre fonctionnement</span>
        </span>
        <code>--bellow · initial</code>
      </div>
      <div class="ds__item">
        <span class="index-nav__item index-nav__item--bellow index-nav__item--hover">
          <span class="index-nav__dot" aria-hidden="true"></span>
          <span class="index-nav__label">Notre fonctionnement</span>
        </span>
        <code>--bellow · hover</code>
      </div>
      <div class="ds__item">
        <span class="index-nav__item index-nav__item--bellow index-nav__item--pressed">
          <span class="index-nav__dot" aria-hidden="true"></span>
          <span class="index-nav__label">Notre fonctionnement</span>
        </span>
        <code>--bellow · pressed</code>
      </div>
      <div class="ds__item">
        <span class="index-nav__item index-nav__item--collapsed" tabindex="0">
          <span class="index-nav__dot" aria-hidden="true"></span>
          <span class="index-nav__label">Notre fonctionnement</span>
        </span>
        <code>--collapsed · survol → étiquette</code>
      </div>
    </div>

    <h3 class="ds__subsection-title">Mobile</h3>
    <div class="ds__group ds__group--index">
      <div class="ds__item">
        <span class="index-nav__item index-nav__item--mobile index-nav__item--start">
          <span class="index-nav__dot" aria-hidden="true"></span>
          <span class="index-nav__label">Notre fonctionnement</span>
        </span>
        <code>--mobile --start</code>
      </div>
      <div class="ds__item">
        <span class="index-nav__item index-nav__item--mobile index-nav__item--bellow">
          <span class="index-nav__dot" aria-hidden="true"></span>
          <span class="index-nav__label">Notre fonctionnement</span>
        </span>
        <code>--mobile --bellow · initial</code>
      </div>
      <div class="ds__item">
        <span class="index-nav__item index-nav__item--mobile index-nav__item--bellow index-nav__item--touch-drag">
          <span class="index-nav__dot" aria-hidden="true"></span>
          <span class="index-nav__label">Notre fonctionnement</span>
        </span>
        <code>--mobile --bellow · touch-and-drag</code>
      </div>
      <div class="ds__item">
        <span class="index-nav__item index-nav__item--mobile index-nav__item--collapsed" tabindex="0">
          <span class="index-nav__dot" aria-hidden="true"></span>
          <span class="index-nav__label">Notre fonctionnement</span>
        </span>
        <code>--collapsed · touch &amp; hold → étiquette</code>
      </div>
    </div>

    <h2 class="ds__section-title">Blocs texte</h2>

    <h3 class="ds__subsection-title">Proposition</h3>
    <p class="ds__note">
      Encart accroche (<code>composant/proposition</code>) : picto « pulpe » + texte
      Ortica Bold. 4 surfaces via modificateur.
    </p>
    <div class="ds__group ds__group--stack">
      <div class="ds__item">
        <div class="proposition">
          <Pulpe class="proposition__picto" aria-hidden="true" />
          <p class="proposition__text">Infos sur les photocopies</p>
        </div>
        <code>.proposition (color=15)</code>
      </div>
      <div class="ds__item">
        <div class="proposition proposition--gradient">
          <Pulpe class="proposition__picto" aria-hidden="true" />
          <p class="proposition__text">Infos sur les photocopies</p>
        </div>
        <code>.proposition--gradient</code>
      </div>
      <div class="ds__item">
        <div class="proposition proposition--none">
          <Pulpe class="proposition__picto" aria-hidden="true" />
          <p class="proposition__text">Infos sur les photocopies</p>
        </div>
        <code>.proposition--none</code>
      </div>
      <div class="ds__item">
        <div class="proposition proposition--outline">
          <Pulpe class="proposition__picto" aria-hidden="true" />
          <p class="proposition__text">Infos sur les photocopies</p>
        </div>
        <code>.proposition--outline</code>
      </div>
    </div>

    <h3 class="ds__subsection-title">Bloc simple</h3>
    <div class="ds__group ds__group--stack">
      <div class="ds__item">
        <p class="bloc-simple">{loremRegular}</p>
        <code>.bloc-simple (regular)</code>
      </div>
      <div class="ds__item">
        <p class="bloc-simple bloc-simple--highlight">{loremHighlight}</p>
        <code>.bloc-simple--highlight</code>
      </div>
    </div>

    <h2 class="ds__section-title">Tarif</h2>
    <p class="ds__note">
      Carte forfait (<code>atome/forfait</code>). 2 niveaux : grand public (sable) et
      communautaire (pêche).
    </p>
    <div class="ds__group ds__group--index">
      <article class="forfait">
        <header class="forfait__header"><h4 class="forfait__titre">Grand public</h4></header>
        <div class="forfait__body">
          <p class="forfait__prix">
            <img class="forfait__picto" src={orangerieUrl} alt="" aria-hidden="true" />
            <span class="forfait__montant">150 €/mois</span>
          </p>
          <p class="forfait__desc">Un poste dédié, accès 7j/7, tous les services inclus.</p>
          <p class="forfait__details">Café, fibre, salle de réunion, cuisine partagée.</p>
        </div>
      </article>
      <article class="forfait forfait--communautaire">
        <header class="forfait__header"><h4 class="forfait__titre">Communautaire</h4></header>
        <div class="forfait__body">
          <p class="forfait__prix">
            <img class="forfait__picto" src={orangerieUrl} alt="" aria-hidden="true" />
            <span class="forfait__montant">90 €/mois</span>
          </p>
          <p class="forfait__desc">Pour les membres de l’association Pulpe.</p>
          <p class="forfait__details">Accès mutualisé aux open spaces et services.</p>
        </div>
      </article>
    </div>

    <h2 class="ds__section-title">Text box liste</h2>
    <p class="ds__note">
      Encart liste (<code>composant/text-box-liste</code>) : boîte sable, gros arrondi
      haut-gauche, lignes picto flèche + texte.
    </p>
    <div class="ds__group ds__group--stack">
      <div class="ds__item">
        <div class="text-box-liste">
          <p class="text-box-liste__item">
            <img class="text-box-liste__arrow" src={arrowUrl} alt="" aria-hidden="true" />
            <span class="text-box-liste__text">La salle de réunion est accessible sur réservation pour les adhérent·e·s.</span>
          </p>
          <p class="text-box-liste__item">
            <img class="text-box-liste__arrow" src={arrowUrl} alt="" aria-hidden="true" />
            <span class="text-box-liste__text">Parkings, restaurants et petite restauration accessibles à quelques minutes à pied. Le stationnement n’est pas autorisé dans la cour du lieu partagé.</span>
          </p>
          <p class="text-box-liste__item">
            <img class="text-box-liste__arrow" src={arrowUrl} alt="" aria-hidden="true" />
            <span class="text-box-liste__text">Thé et café moulu à volonté.</span>
          </p>
          <p class="text-box-liste__item">
            <img class="text-box-liste__arrow" src={arrowUrl} alt="" aria-hidden="true" />
            <span class="text-box-liste__text">Cuisine et salle à manger partagées.</span>
          </p>
        </div>
        <code>.text-box-liste</code>
      </div>
    </div>
  </section>
</Layout>

<style lang="scss">
  .ds__title {
    font-family: var(--font-heading);
    font-size: var(--step-3);
    margin-bottom: var(--space-40);
  }

  .ds__section-title {
    font-family: var(--font-heading);
    font-size: var(--step-1);
    margin-top: var(--space-2xl);
    margin-bottom: var(--space-20);
  }

  .ds__subsection-title {
    font-family: var(--font-heading);
    font-size: var(--step-0);
    margin-bottom: var(--space-20);
    color: var(--sapin-80);
  }

  .ds__note {
    max-width: 60ch;
    margin-bottom: var(--space-30);
    font-size: var(--step--1);
    color: var(--sapin-60);
  }

  .ds__group {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-40);
    align-items: flex-start;
  }

  // Boutons d'index / cartes tarif : plus d'air, alignement bas (tailles variées).
  .ds__group--index {
    align-items: flex-end;
    gap: var(--space-30) var(--space-40);
    margin-bottom: var(--space-l);
  }

  // Blocs texte pleine largeur empilés, largeur de lecture bornée.
  .ds__group--stack {
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-30);
    margin-bottom: var(--space-l);
  }

  .ds__group--stack .ds__item {
    width: 100%;
    max-width: 30rem;
  }

  .forfait {
    width: 20.625rem; // 330px — largeur maquette
    max-width: 100%;
  }

  .ds__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
    align-items: flex-start;

    code {
      font-size: var(--step--1);
      color: var(--sapin-60);
    }
  }
</style>
