---
import Layout from '../layouts/Layout.astro'
import Copier from '../assets/pictos/copier.svg'
import textes from '../data/textes.json'

// Contact — formulaire (nom, email, objet, message) + coordonnées + carte
// Leaflet/OSM. Page non maquettée (cf. SITE-PLAN.md).
// Formulaire masqué temporairement (SMTP non branché) — coordonnées directes
// affichées à la place. Remettre SHOW_FORM à true une fois le SMTP connecté.
const SHOW_FORM = false

const { titre, message_temporaire, email, horaires, adresse, telephone, titre_trouver } = textes.contact_
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(adresse)}`
---

<Layout title="Contact — L'Orangerie">
  <section class="u-container u-section contact">
    <h1 class="contact__title">Contact</h1>

    <div class="contact__grid">
      {SHOW_FORM && (
        <form class="contact__form" method="post">
          <div class="contact__field">
            <label for="nom">Nom</label>
            <input type="text" id="nom" name="nom" required autocomplete="name" />
          </div>
          <div class="contact__field">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" required autocomplete="email" />
          </div>
          <div class="contact__field">
            <label for="objet">Objet</label>
            <input type="text" id="objet" name="objet" required />
          </div>
          <div class="contact__field">
            <label for="message">Message</label>
            <textarea id="message" name="message" rows="6" required></textarea>
          </div>
          <button type="submit" class="btn--primary">Envoyer</button>
        </form>
      )}

      <aside class="contact__infos">
        <div class="contact__bloc">
          <h2 class="titre-paragraphe">{titre}</h2>
          <p class="bloc-simple">{message_temporaire}</p>
          <div class="bloc-simple contact__email-row">
            <a class="btn--lien" href={`mailto:${email}`}>{email}</a>
            <button
              type="button"
              class="btn--lien contact__copy"
              data-copy-email={email}
            >
              <Copier class="contact__copy-icon" aria-hidden="true" />
            </button>
          </div>

          <div class="bloc-simple">
            <a class="btn--lien" href={`tel:${telephone.replace(/\s/g, '')}`}>{telephone}</a>
          </div>
        </div>

        <div class="contact__bloc">
          <h2 class="titre-paragraphe">{titre_trouver}</h2>
          <div class="bloc-simple contact__email-row">  
            <address class="contact__adresse">
              {adresse}
            </address>
            <a class="btn--lien" href={mapsUrl} target="_blank" rel="noopener noreferrer">Ouvrir dans maps</a>
          </div>
          <p class="bloc-simple">{horaires}</p>

          <div id="contact-map" class="contact__map" role="img" aria-label="Carte de localisation de L'Orangerie"></div>
        </div>
      </aside>
    </div>
  </section>
</Layout>

<script>
  import L from 'leaflet'
  import 'leaflet/dist/leaflet.css'

  const mapEl = document.getElementById('contact-map')
  if (mapEl) {
    // Géocodage du 9/13 faubourg Sainte-Anne, 56140 Malestroit (Nominatim/OSM).
    const lat = 47.8084096
    const lng = -2.3852978

    const map = L.map(mapEl, {
      center: [lat, lng],
      zoom: 17,
      scrollWheelZoom: false,
    })

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
      maxZoom: 19,
    }).addTo(map)

    const markerIcon = L.divIcon({
      className: 'contact__marker',
      html: `<svg width="32" height="42" viewBox="0 0 32 42" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M16 0C7.163 0 0 7.163 0 16c0 11 16 26 16 26s16-15 16-26c0-8.837-7.163-16-16-16Z" fill="var(--action-button-primary-initial)"/>
        <circle cx="16" cy="16" r="6" fill="var(--sable-05)"/>
      </svg>`,
      iconSize: [32, 42],
      iconAnchor: [16, 42],
    })

    L.marker([lat, lng], { icon: markerIcon }).addTo(map)
  }
</script>

<script>
  const copyBtn = document.querySelector<HTMLButtonElement>('.contact__copy')
  const copyLabel = copyBtn?.querySelector<HTMLElement>('.contact__copy-label')
  if (copyBtn && copyLabel) {
    const defaultLabel = copyLabel.textContent ?? "Copier l'adresse"

    copyBtn.addEventListener('click', async () => {
      const emailAddr = copyBtn.dataset.copyEmail
      if (!emailAddr) return

      try {
        await navigator.clipboard.writeText(emailAddr)
        copyLabel.textContent = 'Adresse copiée'
        setTimeout(() => {
          copyLabel.textContent = defaultLabel
        }, 2000)
      } catch {
        // Presse-papiers indisponible (permissions/contexte non sécurisé) : rien à faire,
        // le mailto reste utilisable.
      }
    })
  }
</script>
