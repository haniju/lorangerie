---
// Section tarifs — 3 forfaits : Coworker (grand public) + Coworker Investi & Copulpeur·euse (communautaire).
// Desktop : tableau-tarifs indent 1 col, forfait-a 2 col, div-b 4 col, gap --space-20.
// Mobile : forfait-a 5 col (pleine utile), div-b scroll horizontal, instances 4 col chacune.
import textes from '../data/textes.json'
import soleilUrl from '../assets/pictos/soleil.svg?url'
import blurredLeavesUrl from '../assets/images/blurred_leaves.jpg?url'

const mode = textes
const t = mode
const tarifs = mode["tarifs_"]
---

<section class="tarifs u-container u-section" id="tarifs">
  <h2 class="index-nav__deco" data-label-for="tarifs">{t["index_"]["tarif"]}</h2>
  <span class="index-sentinel" data-sentinel-start data-section-ref="tarifs" aria-hidden="true"></span>
  <span class="index-sentinel" data-sentinel-bellow data-section-ref="tarifs" aria-hidden="true"></span>
  <span class="index-sentinel" data-sentinel-after data-section-ref="tarifs" aria-hidden="true"></span>
  <div class="proposition proposition--none proposition--section-intro">
    <p class="proposition__text">{tarifs["infos"]}</p>
  </div>

  <div class="tarifs__tableau">
    <!-- a. Coworker — forfait grand public + CTA -->
    <div class="tarifs__forfait-a">
      <article class="forfait">
        <div class="forfait__header">
          <h3 class="forfait__titre">{tarifs["coworker_"]["titre"]}</h3>
        </div>
        <div class="forfait__body">
          <div class="forfait__prix">
            <img class="forfait__picto" src={soleilUrl} alt="" aria-hidden="true" />
            <span class="forfait__montant">{tarifs["coworker_"]["tarif"]}</span>
          </div>
          <p class="forfait__desc">{tarifs["coworker_"]["infos"]}</p>
        </div>
      </article>
      <div class="btn-group">
        <p class="btn-label">{tarifs["btnprimarylabel"]}</p>
        <a href="#" class="btn--primary">{tarifs["btnprimary"]}</a>
      </div>
    </div>

    <!-- b. Coworker Investi + Copulpeur.euse — forfaits communautaires -->
    <div class="u-scroll-area tarifs__communautaires">
      <article class="forfait forfait--communautaire">
        <div class="forfait__header">
          <h3 class="forfait__titre">{tarifs["investi_"]["titre"]}</h3>
        </div>
        <div class="forfait__body">
          <div class="forfait__prix">
            <img class="forfait__picto" src={soleilUrl} alt="" aria-hidden="true" />
            <span class="forfait__montant">{tarifs["investi_"]["tarif"]}</span>
          </div>
          <p class="forfait__desc">{tarifs["investi_"]["info"]}</p>
          <p class="forfait__sous-titre">{tarifs["investi_"]["sous_titre_1"]}</p>
          <p class="forfait__description">{tarifs["investi_"]["description_1"]}</p>
          <ul class="forfait__details">
            {tarifs["investi_"]["liste_1"].map((item: string) => <li>{item}</li>)}
          </ul>
        </div>
      </article>

      <article class="forfait forfait--communautaire">
        <div class="forfait__header">
          <h3 class="forfait__titre">{tarifs["copulpeur_"]["copulpeur"]}</h3>
        </div>
        <div class="forfait__body">
          <div class="forfait__prix">
            <img class="forfait__picto" src={soleilUrl} alt="" aria-hidden="true" />
            <span class="forfait__montant">{tarifs["copulpeur_"]["tarif"]}</span>
          </div>
          <p class="forfait__desc">{tarifs["copulpeur_"]["info"]}</p>
          <p class="forfait__sous-titre">{tarifs["copulpeur_"]["sous_titre_1"]}</p>
          {tarifs["copulpeur_"]["afficher_description_1"] && (
            <p class="forfait__description">{tarifs["copulpeur_"]["description_1"]}</p>
          )}
          <p class="forfait__sous-titre">{tarifs["copulpeur_"]["sous_titre_2"]}</p>
          {tarifs["copulpeur_"]["afficher_description_2"] && (
            <p class="forfait__description">{tarifs["copulpeur_"]["description_2"]}</p>
          )}
          <ul class="forfait__details">
            {tarifs["copulpeur_"]["liste_2"].map((item: string) => <li>{item}</li>)}
          </ul>
        </div>
      </article>
    </div>
  </div>

  <!-- bloc CTA : fond feuilles floutées, 2 propositions demi-lune + bouton -->
  <div class="tarifs__cta-bloc" style={`background-image: url(${blurredLeavesUrl})`}>
    <div class="tarifs__propositions">
      <div class="proposition proposition--demi-lune tarifs__prop tarifs__prop--1">
        <img class="proposition__picto" src={soleilUrl} alt="" aria-hidden="true" />
        <p class="proposition__text">{tarifs["suisje"]}</p>
      </div>
      <div class="proposition proposition--demi-lune proposition--demi-lune--orange tarifs__prop tarifs__prop--2">
        <img class="proposition__picto" src={soleilUrl} alt="" aria-hidden="true" />
        <p class="proposition__text">{tarifs["question"]}</p>
      </div>
    </div>
    <a href="#" class="btn--secondary tarifs__cta-btn">{tarifs["btnsecondary"]}</a>
  </div>
</section>
