---
// footer/NAV-FOOTER — Figma 44:4570 (desktop 44:4561 / mobile 44:4571).
// Un seul point de bascule structurel (top : row ↔ column) cf. Navbar.
import Facebook from '../assets/pictos/facebook.svg'
import Linkedin from '../assets/pictos/linkedin.svg'
import textes from '../data/textes.json'

const footer = textes.footer

const pageAccueil = [
  { label: 'Le coworking', href: '/#coworking' },
  { label: 'Notre fonctionnement', href: '/#fonctionnement' },
  { label: 'Nos tarifs', href: '/#tarifs' },
  { label: 'À propos de', href: '/#pulpe' },
  { label: 'Nos partenaires', href: '/#partenaires' },
]

const autresPages = [
  { label: footer.bouton6, href: '/contact' },
  { label: footer.bouton7, href: '/faq' },
  { label: footer.bouton8, href: '/design-system' },
]
---

<footer class="site-footer">
  <div class="site-footer__top">
    <div class="site-footer__brand">
      <a href="/" class="site-footer__logo">L'Orangerie</a>
      <p class="bloc-simple site-footer__recap">
        {footer.description}
      </p>
      <div class="site-footer__socials">
        <a href={footer.facebook} class="site-footer__social" aria-label="Facebook">
          <Facebook width={40} height={36} aria-hidden="true" />
        </a>
        <!--a href={footer.linkedin} class="site-footer__social" aria-label="LinkedIn">
          <Linkedin width={40} height={36} aria-hidden="true" />
        </a-->
      </div>
    </div>

    <div class="site-footer__pages">
      <nav class="site-footer__links-group" aria-label={footer.titreplan1}>
        <p class="site-footer__links-title">{footer.titreplan1}</p>
        {pageAccueil.map(({ label, href }) => (
          <a href={href} class="btn--lien">{label}</a>
        ))}
      </nav>
      <nav class="site-footer__links-group" aria-label={footer.titreplan2}>
        <p class="site-footer__links-title">{footer.titreplan2}</p>
        {autresPages.map(({ label, href }) => (
          <a href={href} class="btn--lien">{label}</a>
        ))}
      </nav>
    </div>
  </div>

  <div class="site-footer__legals">
    <p class="bloc-simple site-footer__copyright">{footer.droits}</p>
    <a href="/cgv" class="btn--lien">{footer.cgv}</a>
    <a href="/mentions-legales" class="btn--lien">{footer.mentions}</a>
  </div>
</footer>
