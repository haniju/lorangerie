---
// Rail de navigation des sections (dot-nav, règles R1–R15 — PLAN-ACTION.md).
// Positionné entre Hero et les sections dans index.astro.
// Labels hardcodés — à connecter à textes.json une fois figma-to-content.js en place.

import pulpeLogoUrl from '../assets/logos/pulpe.svg?url'

const sections = [
  { id: 'coworking',      label: 'Notre espace' },
  { id: 'fonctionnement', label: 'Notre fonctionnement' },
  { id: 'tarifs',         label: 'Nos tarifs' },
  { id: 'pulpe',          label: 'à propos de', logo: pulpeLogoUrl },
  { id: 'partenaires',    label: 'Nos partenaires' },
]
---

<nav class="index-nav" aria-label="Navigation des sections">
  <ul class="index-nav__list" role="list">
    {sections.map(({ id, label, logo }, i) => (
      <li>
        <a
          href={`#${id}`}
          class={`index-nav__item ${i === 0 ? 'index-nav__item--start' : 'index-nav__item--collapse-before'}`}
          data-section={id}
          aria-label={label}
        >
          <span class="index-nav__dot" aria-hidden="true"><span class="index-nav__dot-core"></span></span>
          <span class="index-nav__label" aria-hidden="true">
            {label}
            {logo && <img class="index-nav__deco-logo" src={logo} alt="Pulpe" />}
          </span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<script>
  import { initIndexNavTouch, initIndexNavScrollspy, initIndexNavFocus } from '../js/index-nav.ts'
  initIndexNavTouch()
  initIndexNavScrollspy()
  initIndexNavFocus()

  // Le nav suit le top de #coworking : translateY = max(0, coworkingTop - navTop).
  // Quand coworking remonte jusqu'à la position sticky du nav, translateY = 0 → nav calé.
  const nav = document.querySelector<HTMLElement>('.index-nav')
  const coworking = document.getElementById('coworking')

  // Survol d'une entrée → classe .is-dot-hover (délégation ; l'event remonte jusqu'au
  // nav malgré son pointer-events:none). Le CSS repositionne alors l'item --start.
  // On teste .index-nav__item (et non .index-nav__dot) : au repos le label est
  // display:none donc la boîte de l'item ≈ le dot seul (déclenchement de fait « sur le
  // point »), mais une fois le label affiché la classe TIENT jusque sur le label —
  // sinon elle tombait au passage dot→label et le label redisparaissait avant le clic.
  // pointerover/pointerout + pointerType : mouseover/mouseout se déclenchent aussi
  // en synthétique après un tap tactile (compat historique), sans mouseout fiable
  // ensuite (pas de curseur qui bouge) — is-dot-hover restait alors collé sur
  // <nav> après le premier tap. pointerType distingue l'interaction réelle
  // (contrairement à @media (hover:hover), qui ne teste que la capacité de
  // l'appareil et ne suffirait pas sur un hybride souris+tactile).
  nav?.addEventListener('pointerover', (e) => {
    if (e.pointerType !== 'mouse') return
    if ((e.target as HTMLElement).closest?.('.index-nav__item')) nav.classList.add('is-dot-hover')
  })
  nav?.addEventListener('pointerout', (e) => {
    if (e.pointerType !== 'mouse') return
    if (!(e.target as HTMLElement).closest?.('.index-nav__item')) return
    const related = e.relatedTarget as HTMLElement | null
    if (!related?.closest?.('.index-nav__item')) nav.classList.remove('is-dot-hover')
  })

  function updateNavPosition() {
    if (!nav || !coworking) return
    const coworkingTop = coworking.getBoundingClientRect().top
    const navTop = parseFloat(getComputedStyle(nav).top)
    const translate = Math.max(0, coworkingTop - navTop)
    nav.style.transform = `translateY(${translate}px)`
  }

  const scroller = document.querySelector('main') ?? window
  scroller.addEventListener('scroll', updateNavPosition, { passive: true })
  updateNavPosition()

  // Cale --index-nav-left sur le bord gauche RÉEL de .u-container (mesuré via
  // #coworking, qui porte aussi cette classe) plutôt que de le recalculer en CSS
  // via 100vw. .index-nav est position:fixed → son containing block est le
  // viewport, alors que .u-container se centre (margin-inline:auto) par rapport
  // à <main>, dont la largeur de contenu est réduite par SA PROPRE scrollbar
  // (overflow-y:auto). 100vw ignore cette scrollbar (elle n'est pas au niveau
  // document, html/body étant en overflow:hidden) → les deux formules divergent
  // dès que la fenêtre dépasse --content-cap, d'un écart = moitié de la largeur
  // de la scrollbar. Mesurer la vraie position élimine le problème à la racine.
  function updateNavLeft() {
    if (!nav || !coworking) return
    nav.style.setProperty('--index-nav-left', `${coworking.getBoundingClientRect().left}px`)
  }

  window.addEventListener('resize', updateNavLeft, { passive: true })
  updateNavLeft()
</script>
