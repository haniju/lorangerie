---
// Rend l'écriture inclusive en stratégie A (INCLUSIVE-WRITING.md §3) :
// aria-label porte la forme orale, le point médian reste le seul contenu
// visible/textuel de l'élément. Testé avec VoiceOver (macOS) : la stratégie B
// (aria-hidden + sr-only) fait lire la forme écrite telle quelle par VoiceOver
// en lecture continue — l'aria-label est en pratique plus fiable.
import lexicon from '../data/inclusive-lexicon.json'

interface Props {
  text: string
}

const { text } = Astro.props

const tokens = Object.keys(lexicon).sort((a, b) => b.length - a.length)
const escape = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')
const pattern = tokens.length ? new RegExp(`(${tokens.map(escape).join('|')})`, 'g') : null

const parts = pattern ? text.split(pattern) : [text]
---
{parts.map((part) =>
  Object.prototype.hasOwnProperty.call(lexicon, part) ? (
    <span class="incl" aria-label={(lexicon as Record<string, string>)[part]}>{part}</span>
  ) : (
    part
  )
)}
