---
// Google Analytics (GA4) — Consent Mode avancé (Google, requis pour la
// conformité EEE : https://developers.google.com/tag-platform/security/guides/consent).
// gtag.js est toujours chargé, mais aucun cookie n'est posé tant que
// l'utilisateur n'a pas donné son consentement (cf. CookieConsent.astro).
// Jamais chargé hors production.
const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID
---

{
  import.meta.env.PROD && gaId && (
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
    <script define:vars={{ gaId }} is:inline>
      window.dataLayer = window.dataLayer || []
      function gtag() {
        window.dataLayer.push(arguments)
      }
      window.gtag = gtag

      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage:
          localStorage.getItem('cookie-consent') === 'accepted' ? 'granted' : 'denied',
        wait_for_update: 500,
      })

      gtag('js', new Date())
      gtag('config', gaId)
    </script>
  )
}
