---
// Fond animé "orbes" — version prod, config figée (cf. src/js/gradient-background.js).
// Le panneau de réglages / sélecteur de palette / presets restent
// exclusivement sur la branche feature/gradient-background.
---

<div class="gradient-bg">
  <div class="gradient-bg__inner">
    <canvas class="gradient-bg__canvas" aria-hidden="true"></canvas>
  </div>
</div>

<script>
  import { initGradientBackground } from '../js/gradient-background.js'

  const canvasRoot = document.querySelector('.gradient-bg')
  if (canvasRoot) initGradientBackground(canvasRoot)
</script>
