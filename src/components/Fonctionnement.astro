---
// Section fonctionnement (Figma 168:2266 / mobile 219:1845).
// Enchaînement : proposition (width_2) · text-box-liste (width_3) · proposition
// (width_2) + bloc boutons. Un seul markup : empilement vertical en mobile,
// collage 2 colonnes interlock en desktop (≥ 56rem).
// Composants réutilisés : .proposition (variante dégradé/italique), .text-box-liste,
// boutons (.btn--primary / .btn--secondary).
import arrowUrl from '../assets/pictos/simple.svg?url'
import serpentin2Url from '../assets/svg/serpentin_2.svg?url'
import textes from '../data/textes.json'
import Incl from './Incl.astro'

const t = textes
const f = t['fonctionement_']

const prop1 = f['accessible']
const prop2 = f['orangerie']

// fonctionement_/liste_/* (variables string Figma)
const principes = Object.values(f['liste_']) as string[]
---

<section class="fonctionnement u-container u-section" id="fonctionnement">
  <img class="serpentin" src={serpentin2Url} alt="" data-parallax="0.3" aria-hidden="true" />
  <h2 class="index-nav__deco" data-label-for="fonctionnement">{t['index_']['fonctionnement']}</h2>
  <span class="index-sentinel" data-sentinel-start data-section-ref="fonctionnement" aria-hidden="true"></span>
  <span class="index-sentinel" data-sentinel-bellow data-section-ref="fonctionnement" aria-hidden="true"></span>
  <span class="index-sentinel" data-sentinel-after data-section-ref="fonctionnement" aria-hidden="true"></span>
  <div class="fonctionnement__grid">
    <!-- proposition 1 — accroche accès (width_2, coin big haut-droite) -->
    <div class="proposition proposition--gradient fonctionnement__prop fonctionnement__prop--1">
      <p class="proposition__text">{prop1}</p>
    </div>

    <!-- liste des principes (width_3) -->
    <div class="text-box-liste fonctionnement__liste">
      {principes.map((text) => (
        <div class="text-box-liste__item">
          <img class="text-box-liste__arrow" src={arrowUrl} alt="" aria-hidden="true" />
          <p class="text-box-liste__text"><Incl text={text} /></p>
        </div>
      ))}
    </div>

    <!-- proposition 2 — accroche entretien partagé (width_2, coin big bas-droite) -->
    <div class="bento__row bento__row--milieu"></div>
    <div class="proposition proposition--gradient fonctionnement__prop fonctionnement__prop--2">
      <p class="proposition__text"><Incl text={prop2} /></p>
    </div>

    <!-- boutons -->
    <div class="fonctionnement__boutons">
      <div class="btn-group">
        <p class="btn-label">Besoin de clarification&nbsp;?</p>
        <a href="/faq" class="btn--primary fonctionnement__btn">Visite notre F.A.Q</a>
      </div>
      <a href="/contact" class="btn--secondary fonctionnement__btn">Sinon contacte-nous&nbsp;!</a>
    </div>
  </div>
</section>
