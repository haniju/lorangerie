---
// Section pulpe (Figma 482:9032).
// Layout desktop : flex-row, indent col1 gauche.
//   col-textes (col3) | col-media (col2) qui s'étire sur la hauteur des textes.
//   Dans col-media : carousel en position absolute (inset:0) + proposition
//   en position absolute (top/left: -space-50) qui chevauche le carousel.
// Mobile : display:contents sur col-media → order : carousel(1) · textes(2) · proposition(3).

import pulpeGroupe from '../assets/images/pulpe_groupe.jpg'
import pulpeLogoUrl from '../assets/logos/pulpe.svg?url'
import textes from '../data/textes.json'
import concert    from '../assets/images/pulpe/concert.jpg'
import foot       from '../assets/images/pulpe/foot.jpg'
import potager    from '../assets/images/pulpe/potager.jpg'
import repetition from '../assets/images/pulpe/repetition.jpg'
import secours    from '../assets/images/pulpe/secours.jpg'
import theatre    from '../assets/images/pulpe/theatre.jpg'
import travaux    from '../assets/images/pulpe/travaux.jpg'

const photos = [
  { src: concert,    alt: 'Concert au lieu partagé Pulpe' },
  { src: foot,       alt: 'Match de foot organisé par Pulpe' },
  { src: potager,    alt: 'Potager partagé' },
  { src: repetition, alt: 'Répétition musicale' },
  { src: secours,    alt: 'Formation aux premiers secours' },
  { src: theatre,    alt: 'Spectacle de théâtre' },
  { src: travaux,    alt: 'Travaux du bâtiment Faubourg Sainte-Anne' },
]

const p = textes['pulpe_']
---

<section class="pulpe u-container u-section" id="pulpe">
  <h2 class="index-nav__deco" data-label-for="pulpe">à propos de <img class="index-nav__deco-logo" src={pulpeLogoUrl} alt="Pulpe" /></h2>
  <span class="index-sentinel" data-sentinel-start data-section-ref="pulpe" aria-hidden="true"></span>
  <span class="index-sentinel" data-sentinel-bellow data-section-ref="pulpe" aria-hidden="true"></span>
  <span class="index-sentinel" data-sentinel-after data-section-ref="pulpe" aria-hidden="true"></span>

  <div class="proposition proposition--none proposition--section-intro pulpe__intro">
    <p class="proposition__text">
      {p['intro']}
    </p>
  </div>

  <div class="pulpe__grid pulpe_presentation">
    <!-- col1 : textes + bouton -->
    <div class="pulpe__col-textes">
      <div class="u-scroll-area wrapper">
        <div class="pulpe__group-texte">
          <h3 class="pulpe__titre">{p['histotitre']}</h3>
          <p class="pulpe__texte">
            {p['historique']}
          </p>
        </div>
        <div class="pulpe__group-texte">
          <h3 class="pulpe__titre">{p['aujtitre']}</h3>
          <p class="pulpe__texte">
            {p['aujourdhui']}
          </p>
        </div>
      </div>
      <div class="btn-group">
        <p class="btn-label">Envie de nous rejoindre&nbsp;?</p>
        <a data-sentinel-for="pulpe" href="/contact" class="btn--primary pulpe__btn">Contacte PULPE&nbsp;!</a>
      </div>
    </div>

    <!-- col2 : carousel + proposition en overlap (display:contents en mobile) -->
    <div class="pulpe__col-media">
      <!-- carousel : crossfade auto, remplit tout le col-media en desktop -->
      <div class="pulpe__carousel" role="img" aria-label="Photos des activités de Pulpe">
        {photos.map(({ src, alt }, i) => (
          <img
            class:list={['pulpe__carousel-img', { 'is-active': i === 0 }]}
            src={src.src}
            width={src.width}
            height={src.height}
            alt={alt}
            loading={i === 0 ? 'eager' : 'lazy'}
          />
        ))}
      </div>

      <!-- proposition : absolute desktop (chevauchement top-left), flow normal mobile -->
      <div class="proposition proposition--gradient pulpe__proposition">
        <p class="proposition__text">
          «&nbsp;Coworking progress&nbsp;» comme on aime à dire à l'Orangerie
        </p>
      </div>
    </div>
  </div>
  <img
    class="pulpe__groupe"
    src={pulpeGroupe.src}
    width={pulpeGroupe.width}
    height={pulpeGroupe.height}
    alt="L'équipe et les membres de l'association Pulpe"
    loading="lazy"
  />
</section>

<script>
  const carousel = document.querySelector<HTMLElement>('.pulpe__carousel')
  if (carousel) {
    const imgs = Array.from(carousel.querySelectorAll<HTMLElement>('.pulpe__carousel-img'))
    if (imgs.length > 1 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      let current = 0
      setInterval(() => {
        imgs[current].classList.remove('is-active')
        current = (current + 1) % imgs.length
        imgs[current].classList.add('is-active')
      }, 4000)
    }
  }
</script>
